{{ 'travelia-planner.css' | asset_url | stylesheet_tag }}
<section id="planifica" class="travelia-planner wrap section-space" aria-labelledby="travelia-title-{{ section.id }}">
  <travelia-planner data-engine="{{ 'travelia-itinerary.js' | asset_url }}">
    <div data-intro class="tp-intro">
      <p class="eyebrow">Planificador de viajes</p>
      <h2 id="travelia-title-{{ section.id }}">Tu próximo viaje por el Perú</h2>
      <p>Responde diez preguntas para encontrar una ruta que se adapte a ti.</p>
    </div>
    <noscript>Activa JavaScript para usar el planificador.</noscript>
    <p data-load-error role="alert" hidden>No pudimos cargar el planificador. Vuelve a cargar esta página.</p>
    <form class="tp-form" hidden novalidate>
      <p class="tp-step" data-step-label aria-live="polite"></p>
      <progress value="1" max="10" aria-label="Progreso del cuestionario"></progress>
      <fieldset data-step="1">
        <legend tabindex="-1">¿Qué destino te gustaría conocer?</legend>
        <div class="tp-choices"><label class="tp-choice"><input type="radio" name="destinationMode" value="elegido"><span>Tengo un destino en mente</span></label><label class="tp-choice"><input type="radio" name="destinationMode" value="descubrir"><span>Quiero descubrir nuevos lugares</span></label><label class="tp-choice"><input type="radio" name="destinationMode" value="recomendar"><span>Quiero que me recomienden un destino</span></label></div><div data-conditional="destination" hidden><label class="tp-field">Destino<select name="destination"><option value="">Selecciona una opción</option><option value="colca">Cañón del Colca</option>
<option value="gocta">Catarata de Gocta</option>
<option value="kuelap">Kuélap</option>
<option value="titicaca">Lago Titicaca</option>
<option value="humantay">Laguna Humantay</option>
<option value="machupicchu">Machu Picchu</option>
<option value="vinicunca">Montaña de 7 Colores</option>
<option value="huacachina">Huacachina</option>
<option value="otro">Otro destino</option></select></label><div data-conditional="customDestination" hidden><label class="tp-field">Escribe tu destino<input name="customDestination" maxlength="80" type="text"></label></div></div>
      </fieldset>
      <fieldset data-step="2" hidden>
        <legend tabindex="-1">¿Qué tipo de destino prefieres?</legend>
        <p>Puedes seleccionar varias opciones.</p><div class="tp-choices"><label class="tp-choice"><input type="checkbox" name="types" value="naturaleza"><span>Playas y naturaleza</span></label><label class="tp-choice"><input type="checkbox" name="types" value="montaña"><span>Montañas y aventura</span></label><label class="tp-choice"><input type="checkbox" name="types" value="cultura"><span>Cultura e historia</span></label><label class="tp-choice"><input type="checkbox" name="types" value="ciudad"><span>Gastronomía y ciudades</span></label><label class="tp-choice"><input type="checkbox" name="types" value="mixto"><span>Una combinación de varios</span></label></div>
      </fieldset>
      <fieldset data-step="3" hidden>
        <legend tabindex="-1">¿En qué fecha deseas viajar?</legend>
        <div class="tp-choices"><label class="tp-choice"><input type="radio" name="dateMode" value="fija"><span>Tengo fechas definidas</span></label><label class="tp-choice"><input type="radio" name="dateMode" value="flexible"><span>Mis fechas son flexibles</span></label></div><div data-conditional="dates" hidden><div class="tp-pair"><label class="tp-field">Fecha de inicio<input type="date" name="startDate"></label><label class="tp-field">Fecha de retorno<input type="date" name="endDate"></label></div></div>
      </fieldset>
      <fieldset data-step="4" hidden>
        <legend tabindex="-1">¿Cuántos días tienes disponibles?</legend>
        <p data-derived-days hidden></p><div data-conditional="duration" hidden><label class="tp-field">Rango de duración<select name="durationBand"><option value="">Selecciona una opción</option><option value="breve">1 a 2 días</option>
<option value="corto">3 a 4 días</option>
<option value="semana">5 a 7 días</option>
<option value="largo">Más de una semana (hasta 30 días)</option></select></label><label class="tp-field">Número exacto de días<input name="duration" type="number" min="1" max="30" step="1" value=""></label></div>
      </fieldset>
      <fieldset data-step="5" hidden>
        <legend tabindex="-1">¿Con quién realizarás el viaje?</legend>
        <div class="tp-choices"><label class="tp-choice"><input type="radio" name="group" value="solo"><span>Solo</span></label><label class="tp-choice"><input type="radio" name="group" value="pareja"><span>En pareja</span></label><label class="tp-choice"><input type="radio" name="group" value="amigos"><span>Con amigos</span></label><label class="tp-choice"><input type="radio" name="group" value="familia"><span>En familia</span></label><label class="tp-choice"><input type="radio" name="group" value="organizado"><span>En grupo organizado</span></label></div>
      </fieldset>
      <fieldset data-step="6" hidden>
        <legend tabindex="-1">¿Cuántas personas viajarán?</legend>
        <div class="tp-pair"><label class="tp-field">Adultos<input name="adults" type="number" min="1" max="50" step="1" value=""></label><label class="tp-field">Niños<input name="children" type="number" min="0" max="49" step="1" value="0"></label></div>
      </fieldset>
      <fieldset data-step="7" hidden>
        <legend tabindex="-1">¿Cuál es tu presupuesto aproximado por persona?</legend>
        <div class="tp-choices"><label class="tp-choice"><input type="radio" name="budgetBand" value="bajo"><span>Menos de S/ 300</span></label><label class="tp-choice"><input type="radio" name="budgetBand" value="medio"><span>S/ 300 a S/ 600</span></label><label class="tp-choice"><input type="radio" name="budgetBand" value="alto"><span>S/ 600 a S/ 1,000</span></label><label class="tp-choice"><input type="radio" name="budgetBand" value="comodo"><span>S/ 1,000 a S/ 1,500</span></label><label class="tp-choice"><input type="radio" name="budgetBand" value="amplio"><span>Más de S/ 1,500</span></label><label class="tp-choice"><input type="radio" name="budgetBand" value="personalizado"><span>Otro monto</span></label></div><div data-conditional="budget" hidden><label class="tp-field">Presupuesto por persona en soles<input name="budget" type="number" min="1" max="100000" step="0.01" value=""></label></div>
      </fieldset>
      <fieldset data-step="8" hidden>
        <legend tabindex="-1">¿Qué actividades te gustaría realizar durante tu viaje?</legend>
        <p>Puedes seleccionar varias opciones.</p><div class="tp-choices"><label class="tp-choice"><input type="checkbox" name="activities" value="trekking"><span>Caminatas y trekking</span></label><label class="tp-choice"><input type="checkbox" name="activities" value="aventura"><span>Deportes de aventura</span></label><label class="tp-choice"><input type="checkbox" name="activities" value="cultura"><span>Visitas culturales e históricas</span></label><label class="tp-choice"><input type="checkbox" name="activities" value="comida"><span>Gastronomía local</span></label><label class="tp-choice"><input type="checkbox" name="activities" value="fotos"><span>Fotografía y paisajes</span></label><label class="tp-choice"><input type="checkbox" name="activities" value="descanso"><span>Descanso y relajación</span></label><label class="tp-choice"><input type="checkbox" name="activities" value="familia"><span>Actividades familiares</span></label></div>
      </fieldset>
      <fieldset data-step="9" hidden>
        <legend tabindex="-1">¿Qué tipo de alojamiento y transporte prefieres?</legend>
        <div class="tp-pair"><label class="tp-field">Alojamiento<select name="stay"><option value="">Selecciona una opción</option><option value="economico">Económico</option>
<option value="estandar">Estándar</option>
<option value="comodo">Cómodo</option>
<option value="ninguno">No necesito alojamiento</option></select></label><label class="tp-field">Transporte<select name="transport"><option value="">Selecciona una opción</option><option value="bus">Autobús</option>
<option value="tren">Tren</option>
<option value="avion">Avión</option>
<option value="privado">Transporte privado</option>
<option value="flexible">Sin preferencia</option></select></label></div>
      </fieldset>
      <fieldset data-step="10" hidden>
        <legend tabindex="-1">¿Qué tan intenso quieres que sea tu viaje?</legend>
        <div class="tp-choices"><label class="tp-choice"><input type="radio" name="pace" value="relajado"><span>Relajado · pocas actividades y tiempo libre</span></label><label class="tp-choice"><input type="radio" name="pace" value="equilibrado"><span>Equilibrado · actividades y descanso</span></label><label class="tp-choice"><input type="radio" name="pace" value="intenso"><span>Intenso · más actividades por día</span></label></div>
      </fieldset>
      <p data-error class="tp-error" role="alert" hidden></p>
      <div class="actions tp-form-actions">
        <button class="button button-outline" type="button" data-back hidden>Anterior</button>
        <button class="button" type="submit" data-next>Continuar</button>
      </div>
    </form>
    <div data-result class="tp-result" hidden>
      <p class="tp-success"><span aria-hidden="true">✓</span><span><strong>¡Tu itinerario está listo!</strong><br>Preparamos una propuesta de viaje según tus respuestas.</span></p>
      <div class="tp-hero">
        <img data-photo class="tp-photo" width="720" height="480" alt="" hidden>
        <div class="tp-hero-copy">
          <p class="eyebrow" data-origin></p>
          <h3 data-title tabindex="-1"></h3>
          <p data-subtitle></p>
          <p data-hero-details class="tp-hero-details"></p>
        </div>
      </div>
      <div class="tp-result-grid">
        <div>
          <h4>Itinerario sugerido</h4>
          <ol class="tp-days" data-days></ol>
        </div>
        <aside class="tp-summary" aria-label="Resumen del viaje">
          <h4>Resumen del viaje</h4>
          <dl data-summary></dl>
          <p class="tp-estimate">Presupuesto orientativo según tu respuesta. Consulta tarifas, disponibilidad y condiciones con cada proveedor.</p>
          <div class="tp-actions">
            <a class="button" data-packages href="{{ section.settings.experiences_url | default: routes.all_products_collection_url | escape }}">Ver paquetes disponibles</a>
            <button class="button button-outline" type="button" data-reset>Realizar una nueva planificación</button>
            <button class="button button-outline" type="button" data-print>Guardar o imprimir itinerario</button>
          </div>
        </aside>
      </div>
      <h4>Antes de viajar</h4>
      <ul data-tips></ul>
    </div>
    <div hidden data-experiences>
      {% assign handles = 'canon-del-colca,catarata-de-gocta,kuelap,lago-titicaca-e-islas-de-los-uros,laguna-humantay,machu-picchu,montana-de-7-colores,oasis-de-huacachina' | split: ',' %}
      {% for handle in handles %}
        {% assign experience = all_products[handle] %}
        {% if experience != blank and experience.available %}
          <a data-handle="{{ handle | escape }}" href="{{ experience.url }}">{{ experience.title | escape }}</a>
        {% endif %}
      {% endfor %}
    </div>
  </travelia-planner>
</section>
<script type="module" src="{{ 'travelia-planner.js' | asset_url }}"></script>
{% schema %}
{
  "name": "Planificador Travelia",
  "settings": [
    { "type": "url", "id": "experiences_url", "label": "Enlace de experiencias" }
  ],
  "presets": [{ "name": "Planificador Travelia" }]
}
{% endschema %}
