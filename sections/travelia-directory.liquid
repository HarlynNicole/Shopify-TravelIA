            },
            {
              "value": "gocta",
              "label": "Catarata de Gocta"
            },
            {
              "value": "kuelap",
              "label": "Kuélap"
            },
            {
              "value": "titicaca",
              "label": "Lago Titicaca"
            },
            {
              "value": "humantay",
              "label": "Laguna Humantay"
            },
            {
              "value": "machupicchu",
              "label": "Machu Picchu"
            },
            {
              "value": "vinicunca",
              "label": "Montaña de 7 Colores"
            },
            {
              "value": "huacachina",
              "label": "Huacachina"
            },
            {
              "value": "paracas",
              "label": "Islas Ballestas y Reserva Nacional de Paracas"
            },
            {
              "value": "laguna69",
              "label": "Laguna 69"
            },
            {
              "value": "chanchan",
              "label": "Complejo Arqueológico Chan Chan"
            },
            {
              "value": "manu",
              "label": "Parque Nacional del Manu"
            },
            {
