{%- capture experiences_url -%}{%- render 'travelia-experiences-url' -%}{%- endcapture -%}
{{ 'travelia-directory.css' | asset_url | stylesheet_tag }}
<section id="destinos" class="wrap section-space">
  <div class="section-heading">
    <div><p class="eyebrow">Guía de destinos</p><h2>Catorce lugares para descubrir</h2></div>
    <a href="{{ experiences_url }}">Ver experiencias de la tienda</a>
  </div>
  <travelia-directory data-catalog="{{ 'travelia-destinations.js' | asset_url }}" data-home="{{ routes.root_url }}">
    <div class="actions td-filters" role="group" aria-label="Filtrar destinos por región natural" hidden>
      <button class="button button-outline" type="button" data-area="" aria-pressed="true">Todos</button>
      <button class="button button-outline" type="button" data-area="Costa" aria-pressed="false">Costa</button>
      <button class="button button-outline" type="button" data-area="Sierra" aria-pressed="false">Sierra</button>
      <button class="button button-outline" type="button" data-area="Selva" aria-pressed="false">Selva</button>
    </div>
    <p data-count role="status"></p>
    <ul class="destination-grid td-grid" data-cards role="list"></ul>
    <noscript>Activa JavaScript para consultar la guía de destinos.</noscript>
    <div hidden>
      {% for block in section.blocks %}
        {% assign experience = block.settings.experience %}
        <div data-destination="{{ block.settings.destination | escape }}" {{ block.shopify_attributes }}>
          {% if block.settings.photo != blank %}
            <span data-photo="{{ block.settings.photo | image_url: width: 800 }}"></span>
          {% endif %}
          {% if experience != blank %}
            <a href="{{ experience.url }}" data-price="{% if experience.price_varies %}Desde {% endif %}{{ experience.price | money_with_currency | escape }}{% unless experience.available %} · Agotado{% endunless %}">Experiencia</a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </travelia-directory>
</section>
<script type="module" src="{{ 'travelia-directory.js' | asset_url }}"></script>
{% schema %}
{
  "name": "Directorio de destinos",
  "max_blocks": 14,
  "settings": [],
  "blocks": [
    {
      "type": "destination",
      "name": "Destino en Shopify",
      "settings": [
        {
          "type": "select",
          "id": "destination",
          "label": "Destino",
          "options": [
            {
              "value": "colca",
